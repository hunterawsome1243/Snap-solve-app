# Copy this file to ".env" (same folder) and paste your key after the equals sign.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=paste-your-key-here

# Optional: change the model used for reading + solving.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional cost controls (all off by default, so nothing changes until you set them).
# Thinking effort: low | medium | high | xhigh | max. Set EFFORT for every call, or EFFORT_<NAME> for one:
#   EFFORT_READ, EFFORT_SOLVE, EFFORT_FORMULATE, EFFORT_PRACTICE, EFFORT_IDENTIFY, EFFORT_PLANT, EFFORT_PRICES
# EFFORT_IDENTIFY=low
# Web searches allowed per price check (1-10, default 5). Each search is billed on top of the tokens.
# WEB_SEARCH_MAX_USES=3
